<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
<meta name="theme-color" content="#ffffff">
<title>TradeVoice — Indian Markets</title>
<style>
:root{--bg:#f5f6f8;--card:#fff;--text:#17191d;--muted:#707782;--line:#e5e8ec;--green:#138a43;--red:#d83b3b;--blue:#2468e8;--dark:#111827;--soft:#f2f5f8}
*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
button,input,select{font:inherit}.app{max-width:1280px;margin:auto}.top{background:#fff;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:20;padding:12px 18px}.row{display:flex;align-items:center;justify-content:space-between;gap:10px}.brand{font-size:21px;font-weight:900}.brand span{color:var(--green)}.live{font-size:12px;color:var(--green);font-weight:800}.search{margin-top:11px;background:#f0f2f5;border-radius:11px;padding:10px 13px;display:flex;align-items:center;gap:8px}.search input{width:100%;border:0;outline:0;background:transparent;font-size:15px}
.tabs{display:flex;gap:7px;overflow:auto;margin-top:11px;padding-bottom:2px}.tab{border:1px solid var(--line);background:#fff;border-radius:9px;padding:8px 12px;white-space:nowrap;font-size:12px;font-weight:750}.tab.active{background:var(--dark);color:#fff}
main{padding:16px 18px 35px}.section{font-size:16px;font-weight:850;margin:17px 0 10px}.indices{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.card,.panel{background:var(--card);border:1px solid var(--line);border-radius:14px}.card{padding:14px}.muted{color:var(--muted);font-size:12px}.title{font-weight:800}.price{font-size:21px;font-weight:900;margin-top:6px}.up{color:var(--green)}.down{color:var(--red)}
.layout{display:grid;grid-template-columns:390px minmax(0,1fr);gap:14px}.list{overflow:hidden}.stock{display:grid;grid-template-columns:40px minmax(0,1fr) auto;gap:10px;align-items:center;padding:12px;border-bottom:1px solid var(--line);cursor:pointer}.stock:last-child{border:0}.stock:hover{background:#fafbfd}.selected{background:#f1f6ff;border-left:3px solid var(--blue)}.icon{width:38px;height:38px;border-radius:10px;background:#edf4ff;color:#2865dc;display:grid;place-items:center;font-weight:900}.metrics{text-align:right;min-width:120px}.chartpanel{padding:16px}.charthead{display:flex;justify-content:space-between;gap:12px}.clock{text-align:right;white-space:nowrap}.chartbox{height:260px;margin-top:12px;border:1px solid var(--line);border-radius:11px;overflow:hidden;background:#fff}.chartbox svg{width:100%;height:100%}.chartgrid line{stroke:#edf0f3;stroke-width:1}.chartline{fill:none;stroke:var(--blue);stroke-width:3}.chartarea{fill:rgba(36,104,232,.08)}.range{display:flex;gap:6px;margin-top:9px}.range button{border:0;background:var(--soft);padding:7px 10px;border-radius:7px;font-size:12px;font-weight:750}.range button.active{background:#dfe9ff;color:#205dcc}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:12px}.stat{background:#f7f8fa;border-radius:9px;padding:9px;min-width:0}.stat b{display:block;margin-top:4px;overflow:hidden;text-overflow:ellipsis}.tools{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}.tools button{border:1px solid var(--line);background:#fff;border-radius:9px;padding:10px 12px;font-weight:800}.tools .primary{background:var(--dark);color:#fff}.funds{display:grid;grid-template-columns:repeat(5,1fr);gap:7px;margin-top:12px}.fund{background:#f7f8fa;border-radius:9px;padding:9px}.fund b{display:block;margin-top:3px}.note{margin-top:12px;padding:11px;background:#f7f8fa;border-radius:10px;font-size:12px;color:#5f6670}.datebar{margin-top:12px;padding:10px 12px;background:#fff;border:1px solid var(--line);border-radius:10px;font-size:12px;display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}
.voicebar{margin-top:12px;padding:12px;background:#f8fafc;border:1px solid var(--line);border-radius:11px}.voicecontrols{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}.voicecontrols select,.voicecontrols button{min-height:42px;border:1px solid var(--line);background:#fff;border-radius:9px;padding:8px 10px}.voicecontrols button{font-weight:800}.voicecontrols .on{background:var(--green);color:#fff}.voicehint{font-size:11px;color:var(--muted);margin-top:7px}.bottom{display:none}.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#111827;color:#fff;padding:10px 14px;border-radius:9px;display:none;z-index:50;max-width:90%;text-align:center}
.sheetback{position:fixed;inset:0;background:rgba(0,0,0,.42);display:none;align-items:flex-end;z-index:40}.sheet{background:#fff;border-radius:18px 18px 0 0;width:min(600px,100%);margin:auto;padding:16px}.sheet button{width:100%;padding:12px;margin-top:8px;border:1px solid var(--line);background:#fff;border-radius:10px;text-align:left;font-weight:750}
@media(max-width:850px){.layout{grid-template-columns:1fr}.indices{grid-template-columns:1fr}.stats{grid-template-columns:repeat(2,1fr)}.funds{grid-template-columns:repeat(2,1fr)}.bottom{display:block;position:sticky;bottom:0;background:#fff;border-top:1px solid var(--line);z-index:20}.nav{display:grid;grid-template-columns:repeat(5,1fr)}.nav button{border:0;background:#fff;padding:9px 2px;color:#777;font-size:11px}.nav b{display:block;font-size:18px}.nav .active{color:var(--green)}}
@media(max-width:430px){main{padding:12px}.top{padding:11px 12px}.metrics{min-width:95px}.stock{grid-template-columns:36px minmax(0,1fr) auto}.icon{width:34px;height:34px}.chartbox{height:220px}}


.modal{position:fixed;inset:0;background:rgba(0,0,0,.65);backdrop-filter:blur(8px);display:grid;place-items:center;z-index:100}
.modal.hidden{display:none}.modal-card{width:min(560px,92vw);max-height:86vh;overflow:auto;background:var(--panel,#0d1825);border:1px solid rgba(255,255,255,.12);border-radius:22px;padding:22px;box-shadow:0 24px 80px rgba(0,0,0,.45)}
.modal-head{display:flex;justify-content:space-between;gap:16px;align-items:flex-start}.modal-head h3{margin:4px 0 6px}.eyebrow{font-size:11px;letter-spacing:.14em;opacity:.65}.muted{opacity:.68}.icon-btn{border:0;background:transparent;color:inherit;font-size:20px;cursor:pointer}
.command-list{display:grid;gap:10px;margin:18px 0}.command-list div{padding:13px 14px;border:1px solid rgba(255,255,255,.08);border-radius:14px;background:rgba(255,255,255,.025)}.command-list b{display:block}.command-list span{display:block;margin-top:4px;font-size:12px;opacity:.65}.command-status{padding:12px;border-radius:12px;background:rgba(0,180,130,.08);margin-bottom:12px;font-size:13px}.full{width:100%}


.order-preview{margin:12px 0;padding:14px;border-radius:14px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.035)}
.order-preview .order-title{font-weight:700;font-size:17px;margin-bottom:8px}.order-preview .order-meta{opacity:.75;font-size:13px;margin-bottom:12px}
.order-preview .confirm{display:flex;gap:10px}.order-preview button{flex:1}

</style>
</head>
<body>
<div class="app">
<header class="top">
  <div class="row"><div class="brand">Trade<span>Voice</span></div><div class="live" id="status">● Connecting</div></div>
  <div class="search">⌕ <input id="search" placeholder="Search company, stock, IPO, MF, gold..." autocomplete="off"></div>
  <div class="tabs" id="tabs">
    <button class="tab active" data-section="Stocks">Stocks</button><button class="tab" data-section="Indices">Indices</button>
    <button class="tab" data-section="IPO">IPO</button><button class="tab" data-section="Mutual Funds">Mutual Funds</button>
    <button class="tab" data-section="Gold">Gold</button><button class="tab" data-section="Watchlist">Watchlist</button>
  </div>
</header>

<main>
<div class="section">Market overview</div>
<div class="indices" id="indices"></div>

<div class="datebar"><span>📅 <b id="date">—</b></span><span>🕐 <b id="clock">—</b></span><span id="feed">Market feed: checking…</span></div>

<div class="section">Stocks</div>
<div class="layout">
  <div class="panel list" id="stocks"></div>
  <section class="panel chartpanel">
    <div class="charthead">
      <div><div class="muted">Selected stock</div><div class="title" id="selName">Select a stock</div><div class="price" id="selPrice">—</div><div id="selChange">—</div></div>
      <div class="clock"><div class="muted">Live time</div><b id="detailClock">—</b></div>
    </div>
    <div class="chartbox">
      <svg id="chart" viewBox="0 0 800 260" preserveAspectRatio="none" aria-label="Selected stock price chart">
        <g class="chartgrid"><line x1="0" y1="52" x2="800" y2="52"/><line x1="0" y1="104" x2="800" y2="104"/><line x1="0" y1="156" x2="800" y2="156"/><line x1="0" y1="208" x2="800" y2="208"/></g>
        <polygon id="area" class="chartarea" points=""></polygon><polyline id="line" class="chartline" points=""></polyline>
      </svg>
    </div>
    <div class="range" id="ranges"><button class="active" data-range="1D">1D</button><button data-range="1W">1W</button><button data-range="1M">1M</button><button data-range="1Y">1Y</button></div>

    <div class="stats" id="stats"></div>
    <div class="funds">
      <div class="fund"><span class="muted">PE</span><b id="pe">—</b></div>
      <div class="fund"><span class="muted">ROCE</span><b id="roce">—</b></div>
      <div class="fund"><span class="muted">ROC</span><b id="roc">—</b></div>
      <div class="fund"><span class="muted">P/B</span><b id="pb">—</b></div>
      <div class="fund"><span class="muted">PEG</span><b id="peg">—</b></div>
    </div>

    <div class="voicebar">
      <div class="row"><div class="title">🔊 Live voice</div><span class="muted" id="voiceState">Off</span></div>
      <div class="voicecontrols">
        <select id="voiceLang" aria-label="Voice language">
          <option value="en-IN">English</option><option value="hi-IN">हिन्दी</option><option value="te-IN">తెలుగు</option>
        </select>
        <button id="voiceBtn" class="primary">Start 1-sec voice</button>
        <button id="stopVoice">Stop</button>
      </div>
      <div class="voicehint">Every update speaks the selected stock, price, date, year and exact time including seconds. Actual available voices depend on the browser/device.</div>
    </div>

    <div class="tools"><button id="alertBtn">🔔 Price alert</button><button id="watchBtn">☆ Watchlist</button><button id="fundBtn">📊 Fundamentals</button></div>
    <div class="note" id="info">Select a company to inspect its live chart and market details. Verified fundamentals are shown only when a trusted fundamentals feed is connected.</div>
  </section>
</div>
</main>
<footer class="bottom"><div class="nav"><button class="active"><b>⌂</b>Home</button><button><b>☆</b>Watchlist</button><button><b>▥</b>Portfolio</button><button><b>▤</b>Orders</button><button><b>☻</b>Profile</button></div></footer>
</div>
<div class="toast" id="toast"></div>
<div class="sheetback" id="sheetback"><div class="sheet"><div class="title" id="sheetTitle">Stock</div><button id="sheetAlert">🔔 Set price alert</button><button id="sheetVoice">🔊 Start one-second voice</button><button id="sheetFund">📊 View fundamentals</button><button id="sheetClose">✕ Close</button></div></div>

<script>
"use strict";
let market={stocks:[],indices:[]},selected=null,history=[],voice=false,voiceTimer=null,speaking=false,watchlist=new Set(),alerts=[],currentRange="1D";
const $=id=>document.getElementById(id);
const money=n=>Number.isFinite(Number(n))?Number(n).toLocaleString("en-IN",{minimumFractionDigits:2,maximumFractionDigits:2}):"—";
const safe=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]));
function toast(s){$("toast").textContent=s;$("toast").style.display="block";clearTimeout(window._toast);window._toast=setTimeout(()=>$("toast").style.display="none",2200)}
function nowParts(){const d=new Date();return {d, date:d.toLocaleDateString("en-IN",{weekday:"long",day:"2-digit",month:"long",year:"numeric"}),time:d.toLocaleTimeString("en-IN",{hour:"2-digit",minute:"2-digit",second:"2-digit",hour12:false})}}
function updateClock(){const n=nowParts();$("date").textContent=n.date;$("clock").textContent=n.time;$("detailClock").textContent=n.time}
function findVoice(locale){const voices=("speechSynthesis"in window)?speechSynthesis.getVoices():[];return voices.find(v=>v.lang.toLowerCase()===locale.toLowerCase())||voices.find(v=>v.lang.toLowerCase().startsWith(locale.slice(0,2).toLowerCase()))||null}
function spokenText(q){const n=nowParts();const lang=$("voiceLang").value;
if(lang==="te-IN") return `${q.symbol}. ధర ${money(q.ltp)} రూపాయలు. తేదీ ${n.date}. సమయం ${n.time}.`;
if(lang==="hi-IN") return `${q.symbol}. कीमत ${money(q.ltp)} रुपये। तारीख ${n.date}। समय ${n.time}।`;
return `${q.symbol}. Price ${money(q.ltp)} rupees. Date ${n.date}. Time ${n.time}.`;
}
function speakCurrent(){if(!voice||!selected||!("speechSynthesis"in window))return;const q=market.stocks.find(x=>x.key===selected.key);if(!q)return;
if(!speaking){speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(spokenText(q));u.lang=$("voiceLang").value;const v=findVoice(u.lang);if(v)u.voice=v;u.rate=.95;u.onend=()=>{speaking=false};u.onerror=()=>{speaking=false};speaking=true;speechSynthesis.speak(u)}
clearTimeout(voiceTimer);voiceTimer=setTimeout(()=>{speaking=false;speakCurrent()},1000)}
function startVoice(){if(!("speechSynthesis"in window)){toast("This browser has no speech synthesis");return}voice=true;$("voiceState").textContent=`ON · ${$("voiceLang").selectedOptions[0].text}`;$("voiceBtn").textContent="Voice ON";$("voiceBtn").classList.add("on");toast("1-second voice started");speakCurrent()}
function stopVoice(){voice=false;clearTimeout(voiceTimer);if("speechSynthesis"in window)speechSynthesis.cancel();speaking=false;$("voiceState").textContent="Off";$("voiceBtn").textContent="Start 1-sec voice";$("voiceBtn").classList.remove("on")}
function renderIndices(){$("indices").innerHTML=market.indices.map(x=>`<div class="card"><div class="title">${safe(x.name)}</div><div class="muted">NSE live</div><div class="price">₹${money(x.ltp)}</div><div class="${Number(x.change)>=0?"up":"down"}">${Number(x.change)>=0?"+":""}${money(x.change)} (${Number(x.percent||0).toFixed(2)}%)</div></div>`).join("")}
function renderStocks(filter=""){const rows=market.stocks.filter(x=>!filter||`${x.symbol} ${x.name}`.toLowerCase().includes(filter.toLowerCase()));
$("stocks").innerHTML=rows.map(x=>`<div class="stock ${selected?.key===x.key?"selected":""}" data-key="${safe(x.key)}"><div class="icon">${safe(x.icon)}</div><div><div class="title">${safe(x.symbol)}</div><div class="muted">${safe(x.name)}</div></div><div class="metrics"><div class="title">₹${money(x.ltp)}</div><div class="${Number(x.change)>=0?"up":"down"}">${Number(x.change)>=0?"+":""}${money(x.change)} (${Number(x.percent||0).toFixed(2)}%)</div></div></div>`).join("")||`<div style="padding:20px;color:#707782">No matching stock</div>`;
document.querySelectorAll(".stock").forEach(el=>{let timer;const open=()=>{selected=market.stocks.find(x=>x.key===el.dataset.key);history=[];renderStocks($("search").value);renderSelected()};el.addEventListener("click",open);el.addEventListener("pointerdown",()=>{timer=setTimeout(()=>openSheet(),600)});["pointerup","pointercancel","pointerleave"].forEach(ev=>el.addEventListener(ev,()=>clearTimeout(timer)))})}
function renderSelected(){if(!selected)return;$("selName").textContent=`${selected.symbol} · ${selected.name}`;$("selPrice").textContent=`₹${money(selected.ltp)}`;$("selChange").className=Number(selected.change)>=0?"up":"down";$("selChange").textContent=`${Number(selected.change)>=0?"+":""}₹${money(selected.change)} (${Number(selected.percent||0).toFixed(2)}%)`;
const vals=[["Open",selected.open],["High",selected.high],["Low",selected.low],["Volume",selected.volume?Number(selected.volume).toLocaleString("en-IN"):"—"],["Prev close",selected.cp],["52W high",selected.yearHigh||"—"],["52W low",selected.yearLow||"—"],["Tick time",selected.ltt?new Date(Number(selected.ltt)).toLocaleTimeString("en-IN"):"live"]];
$("stats").innerHTML=vals.map(v=>`<div class="stat"><span class="muted">${v[0]}</span><b>${typeof v[1]==="number"&&v[1]!==0?money(v[1]):v[1]}</b></div>`).join("");
["pe","roce","roc","pb","peg"].forEach(id=>$(id).textContent="—");drawChart()}
function drawChart(){const pts=history.slice(-120);if(pts.length<2)return;const finite=pts.filter(Number.isFinite);if(finite.length<2)return;const min=Math.min(...finite),max=Math.max(...finite),span=max-min||Math.max(Math.abs(min)*.001,1);const p=finite.map((v,i)=>{const x=12+i*(776/(finite.length-1));const y=235-((v-min)/span)*215;return `${x.toFixed(1)},${y.toFixed(1)}`}).join(" ");$("line").setAttribute("points",p);$("area").setAttribute("points",`12,235 ${p} 788,235`)}
function setAlert(){if(!selected)return toast("Select a stock first");const p=Number(prompt(`Alert price for ${selected.symbol}`,money(selected.ltp)));if(!Number.isFinite(p)||p<=0)return;if(!alerts.some(a=>a.key===selected.key&&a.price===p)){alerts.push({key:selected.key,price:p});toast(`Alert set at ₹${money(p)}`)}}
function checkAlerts(){for(const a of alerts){const q=market.stocks.find(x=>x.key===a.key);if(q&&((q.cp<=a.price&&q.ltp>=a.price)||(q.cp>=a.price&&q.ltp<=a.price))){toast(`🔔 ${q.symbol} reached ₹${money(a.price)}`);alerts=alerts.filter(x=>x!==a)}}}
function openSheet(){if(!selected)return;$("sheetTitle").textContent=`${selected.symbol} · ${selected.name}`;$("sheetback").style.display="flex"}
function closeSheet(){$("sheetback").style.display="none"}
async function load(){try{const r=await fetch("/api/market");const j=await r.json();if(!j.ok)throw Error(j.error);market=j;market.stocks.forEach(x=>history.push(x.ltp));selected=selected&&market.stocks.some(x=>x.key===selected.key)?market.stocks.find(x=>x.key===selected.key):market.stocks[0];$("status").textContent="● Live";$("feed").textContent="Market feed: Upstox";renderIndices();renderStocks($("search").value);renderSelected()}catch(e){$("status").textContent="● API error";$("feed").textContent="Market feed: unavailable";toast(e.message)}}
$("voiceBtn").addEventListener("click",startVoice);$("stopVoice").addEventListener("click",stopVoice);$("voiceLang").addEventListener("change",()=>{if(voice){stopVoice();startVoice()}});
$("alertBtn").addEventListener("click",setAlert);$("watchBtn").addEventListener("click",()=>{if(!selected)return;watchlist.has(selected.key)?(watchlist.delete(selected.key),toast("Removed from watchlist")):(watchlist.add(selected.key),toast("Added to watchlist"))});
$("fundBtn").addEventListener("click",()=>{$("info").textContent="PE, ROCE, ROC, P/B and PEG are intentionally blank until a verified fundamentals data source is connected. This prevents inaccurate investment information.";toast("Verified fundamentals source required")});
$("sheetAlert").addEventListener("click",()=>{setAlert();closeSheet()});$("sheetVoice").addEventListener("click",()=>{closeSheet();startVoice()});$("sheetFund").addEventListener("click",()=>{closeSheet();$("fundBtn").click()});$("sheetClose").addEventListener("click",closeSheet);$("sheetback").addEventListener("click",e=>{if(e.target===$("sheetback"))closeSheet()});
$("search").addEventListener("input",e=>renderStocks(e.target.value));
document.querySelectorAll(".range button").forEach(b=>b.addEventListener("click",()=>{document.querySelectorAll(".range button").forEach(x=>x.classList.remove("active"));b.classList.add("active");currentRange=b.dataset.range;toast(`${currentRange} selected; live chart continues from incoming ticks`)}));
document.querySelectorAll(".tab").forEach(b=>b.addEventListener("click",()=>{document.querySelectorAll(".tab").forEach(x=>x.classList.remove("active"));b.classList.add("active");if(b.dataset.section!=="Stocks")toast(`${b.dataset.section} module ready for its verified data feed`)}));
const es=new EventSource("/ap
